# Server Environment Variables
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/insightflow?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
GEMINI_API_KEY=your_gemini_api_key_here
CLIENT_URL=http://localhost:5173

# Durable Storage Configuration
# Default is 'gridfs' (uses MongoDB Atlas connection - persistent across Render restarts with 0 extra config)
STORAGE_PROVIDER=gridfs

# (Optional) If using Cloudinary raw storage:
# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Client Environment Variables (for Vite frontend)
VITE_API_URL=http://localhost:5000
